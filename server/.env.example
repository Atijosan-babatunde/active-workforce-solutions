# Postgres connection string — any host works (Supabase's free Postgres used
# as a plain database, Neon, Railway, or a local `postgres` instance).
DATABASE_URL=

# Long random secret used to sign/verify login JWTs. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=

# Long random secret staff use to call PATCH /admin/requests/:id/status.
# Sent as: Authorization: Bearer <ADMIN_API_KEY>
ADMIN_API_KEY=

# The exact origin the Next.js frontend is served from — required for CORS
# and for the auth cookie's SameSite/Secure behaviour to work correctly.
# Comma-separate multiple origins (e.g. www + apex domain) if needed.
FRONTEND_ORIGIN=http://localhost:3000

PORT=4000

# development | production — controls cookie Secure/SameSite flags (see
# src/lib/jwt.ts). Production requires HTTPS on both this API and the
# frontend for the auth cookie to work cross-domain.
NODE_ENV=development
