datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String           @id @default(uuid())
  email        String           @unique
  passwordHash String
  createdAt    DateTime         @default(now())
  requests     ServiceRequest[]
}

// source/status are plain strings (not Postgres enums), validated at the API
// boundary with zod — mirrors how the Next.js frontend already encodes them
// as string-literal unions, and avoids a migration for every new value.
model ServiceRequest {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  division    String
  source      String
  description String
  details     Json?
  status      String   @default("submitted")
  createdAt   DateTime @default(now())

  @@index([userId])
}
