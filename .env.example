# CRM integration (see app/api/enquiry/route.ts)
CRM_WEBHOOK_URL=
CRM_API_KEY=

# Postgres connection string — any host works (Neon, Railway, Supabase's
# free Postgres used as a plain database, or a local `postgres` instance).
# See README.md "Client accounts, admin dashboard & the database".
DATABASE_URL=

# Long random secret used to sign/verify both client (/portal) and staff
# (/admin) login JWTs. Generate one with: openssl rand -base64 48
JWT_SECRET=

# Long random secret for staff-only actions: creating an admin account
# (POST /api/admin/auth/signup) and the legacy scriptable status-update
# endpoint (PATCH /api/admin/requests/:id/status). Sent as:
# Authorization: Bearer <ADMIN_API_KEY>
ADMIN_API_KEY=
