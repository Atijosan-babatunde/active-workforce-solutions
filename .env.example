# CRM integration (see app/api/enquiry/route.ts)
CRM_WEBHOOK_URL=
CRM_API_KEY=

# Backend API (see server/ — Express + Prisma + PostgreSQL) for client
# accounts and login/progress-tracking at /portal — see README.md
# "Client accounts & portal" section.
NEXT_PUBLIC_API_URL=

# Must match ADMIN_API_KEY in server/.env exactly — this app's /api/enquiry
# route uses it to authenticate its server-to-server call that records every
# submission for the /admin dashboard. See README.md "Admin dashboard".
ADMIN_API_KEY=
